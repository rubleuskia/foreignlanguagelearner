default_platform(:ios)

platform :ios do
  desc "Sign and upload a build to App Store Connect (TestFlight or App Store draft)"
  lane :publish do
    required = %w[APP_IDENTIFIER APPLE_TEAM_ID PROFILE_NAME ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_CONTENT RELEASE_VERSION BUILD_NUMBER]
    required.each { |key| UI.user_error!("Missing #{key}") if ENV[key].to_s.empty? }
    UI.user_error!("Invalid release version") unless ENV.fetch("RELEASE_VERSION").match?(/\A\d+\.\d+\.\d+\z/)
    channel = ENV.fetch("RELEASE_CHANNEL", "testflight")
    UI.user_error!("Invalid release channel") unless %w[testflight app-store].include?(channel)
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"), is_key_content_base64: true
    )
    # Values are shell-escaped because gym passes xcargs to xcodebuild.
    require 'shellwords'
    settings = {
      'PRODUCT_BUNDLE_IDENTIFIER' => ENV.fetch('APP_IDENTIFIER'),
      'DEVELOPMENT_TEAM' => ENV.fetch('APPLE_TEAM_ID'),
      'CODE_SIGN_STYLE' => 'Manual',
      'CODE_SIGN_IDENTITY' => 'Apple Distribution',
      'PROVISIONING_PROFILE_SPECIFIER' => ENV.fetch('PROFILE_NAME'),
      'MARKETING_VERSION' => ENV.fetch('RELEASE_VERSION'),
      'CURRENT_PROJECT_VERSION' => ENV.fetch('BUILD_NUMBER')
    }
    build_app(
      project: 'ForeignLanguageLearner.xcodeproj', scheme: 'ForeignLanguageLearner',
      configuration: 'Release', clean: true, export_method: 'app-store',
      output_directory: 'build/release', output_name: 'ForeignLanguageLearner.ipa',
      xcargs: settings.map { |key, value| "#{key}=#{Shellwords.escape(value)}" }.join(' '),
      export_options: {
        signingStyle: 'manual', teamID: ENV.fetch('APPLE_TEAM_ID'),
        provisioningProfiles: { ENV.fetch('APP_IDENTIFIER') => ENV.fetch('PROFILE_NAME') }
      }
    )
    if channel == 'testflight'
      upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
    else
      upload_to_app_store(
        api_key: api_key, app_identifier: ENV.fetch('APP_IDENTIFIER'),
        skip_metadata: true, skip_screenshots: true,
        submit_for_review: false, automatic_release: false, force: true
      )
    end
  end
end
